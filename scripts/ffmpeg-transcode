#!/usr/bin/env bash

set -u

# Colors
RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
RESET='\033[0m'

trap 'echo; echo -e "${YELLOW}Interrupted by user (Ctrl+C). Aborting.${RESET}"; exit 130' INT

input_path="${1:-}"

if [[ -z "$input_path" ]]; then
    echo -e "${RED}ERROR:${RESET} Usage: $0 <input_file.mkv|directory>"
    exit 1
fi

if [[ ! -e "$input_path" ]]; then
    echo -e "${RED}ERROR:${RESET} Invalid input: $input_path does not exist."
    exit 1
fi

read -r -p "Enter quality profile value (default=20): " qp

if [[ ! "$qp" =~ ^[0-9]+$ ]]; then
    echo -e "${YELLOW}WARNING:${RESET} Invalid quality value. Using default QP=20."
    qp=20
fi

mkdir -p "$HOME/Videos"

process_file() {
    local file="$1"
    local output_file="$2"

    echo -e "${CYAN}Processing: ${RESET}$file"
    echo -e "${CYAN}Output:     ${RESET}$output_file"

    if [[ -f "$output_file" ]]; then
        echo -e "${YELLOW}WARNING:${RESET} Output already exists. Skipping."
        return 0
    fi

    mkdir -p "$(dirname "$output_file")"

    local cmd=(
        ffmpeg
        -vaapi_device /dev/dri/renderD128
        -i "$file"
        -vf "format=nv12,hwupload"
        -c:v h264_vaapi
        -qp "$qp"
        -map 0
        -c:a copy
        -c:s copy
        "$output_file"
    )

    printf '%bRunning:%b' "$CYAN" "$RESET"
    printf ' %q' "${cmd[@]}"
    printf '\n'

    "${cmd[@]}" </dev/null
    local ret=$?

    if ((ret != 0)); then
        if ((ret > 128)); then
            echo -e "${RED}ERROR:${RESET} ffmpeg died with signal $((ret - 128))"
        else
            echo -e "${RED}ERROR:${RESET} ffmpeg exited with status $ret"
        fi

        return "$ret"
    fi

    echo -e "${GREEN}SUCCESS:${RESET} $output_file"
}

if [[ -d "$input_path" ]]; then

    input_root="$(cd "$input_path" && pwd)"

    echo -e "${CYAN}Scanning recursively:${RESET} $input_root"
    echo -e "${CYAN}Output directory:${RESET}     $HOME/Videos"
    echo -e "${CYAN}Quality (QP):${RESET}          $qp"

    found=0
    failed=0
    skipped=0

    while IFS= read -r -d '' file; do
        found=1

        relative_path="${file#"$input_root"/}"
        relative_output="${relative_path%.mkv}-transcoded.mkv"
        output_file="$HOME/Videos/$relative_output"

        if [[ -f "$output_file" ]]; then
            echo -e "${YELLOW}WARN:${RESET} Already exists, skipping: $output_file"
            ((skipped++))
            continue
        fi

        if ! process_file "$file" "$output_file"; then
            ((failed++))
        fi

    done < <(find "$input_root" -type f -iname '*.mkv' -print0)

    if ((found == 0)); then
        echo -e "${YELLOW}WARNING:${RESET} No .mkv files found."
        exit 0
    fi

    echo -e "${CYAN}Batch complete${RESET}"
    echo -e "  Skipped: ${YELLOW}${skipped}${RESET}"
    echo -e "  Failed:  ${RED}${failed}${RESET}"

else
    filename="$(basename "$input_path")"
    output_base="${filename%.mkv}"
    output_file="$HOME/Videos/${output_base}-transcoded.mkv"

    process_file "$input_path" "$output_file"
    exit $?
fi
