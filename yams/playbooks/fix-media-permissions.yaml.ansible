---
- name: Assert media file permissions
  hosts: lab
  become: true

  vars:
    media_roots:
      - /srv/media
      - /mnt/hdd1/media
    owner: loganp
    group: media

  tasks:
    - name: chown -R
      ansible.builtin.command:
        cmd: "chown -R {{ owner }}:{{ group }} {{ item }}"
      loop: "{{ media_roots }}"
      changed_when: true

    - name: chmod 2775
      ansible.builtin.command:
        cmd: "find {{ item }} -type d -exec chmod 2775 {} +"
      loop: "{{ media_roots }}"
      changed_when: true

    - name: chmod 644
      ansible.builtin.command:
        cmd: "find {{ item }} -type f -exec chmod 644 {} +"
      loop: "{{ media_roots }}"
      changed_when: true
